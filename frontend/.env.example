# API Backend URL
VITE_API_URL=http://localhost:3001/api

# App Title
VITE_APP_TITLE=MAEXTRIA - Plataforma de Cursos Online

# --- Local Development Configuration ---
# Set to 'true' to use the local Node.js backend for authentication instead of Supabase Auth.
# If 'true', VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY can be dummy values.
VITE_USE_LOCAL_AUTH=true

# Supabase Configuration (Required by client, can be dummy values if VITE_USE_LOCAL_AUTH is true)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Google Analytics 4 - Obtenha em https://analytics.google.com
# Deixe vazio para desabilitar analytics
# Exemplo: G-ABC123XYZ9
VITE_GA_MEASUREMENT_ID=
